# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=drycleaning_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@veeclen.local

# Delivery-agent login OTP challenge-ID secret (min 32 bytes dedicated secret)
DELIVERY_AGENT_LOGIN_CHALLENGE_ID_SECRET=replace-with-a-dedicated-challenge-id-secret

# Delivery-agent OTP development console fallback (strictly development only; requires DEBUG=True)
DELIVERY_AGENT_OTP_CONSOLE_FALLBACK=False

# Delivery-agent login rate-limit key utilities
DELIVERY_AGENT_LOGIN_RATE_LIMIT_HMAC_SECRET=replace-with-a-dedicated-rate-limit-secret
DELIVERY_AGENT_LOGIN_RATE_LIMIT_HMAC_KEY_VERSION=v1
DELIVERY_AGENT_LOGIN_RATE_LIMIT_PREVIOUS_HMAC_SECRET=
DELIVERY_AGENT_LOGIN_RATE_LIMIT_PREVIOUS_HMAC_KEY_VERSION=
DELIVERY_AGENT_LOGIN_RATE_LIMIT_LOCK_SECRET=replace-with-a-separate-stable-lock-secret
DELIVERY_AGENT_LOGIN_TRUSTED_PROXY_CIDRS=
